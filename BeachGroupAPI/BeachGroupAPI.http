@base_url = http://localhost:5000
### @token = 

### Login
# @name login
POST {{base_url}}/api/login
Content-Type: application/json

{
  "Email": "usuario2@usuario.com",
  "senha": "123456"
}

### Criar usuário
POST {{base_url}}/api/usuarios
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "Nome": "Usuario 2 Sobrenome 2",
  "Email": "usuario2@usuario.com",
  "Senha": "123456"
}

### Retornar usuários
GET {{base_url}}/api/usuarios
Authorization: Bearer {{login.response.body.$.token}}
Accept: application/json


### //------------------------------------
### // Quadras
### //------------------------------------

### Consultar Quadra
GET {{base_url}}/api/quadras/1
Authorization: Bearer {{login.response.body.$.token}}
Accept: application/json

### Listar Quadras
GET {{base_url}}/api/quadras
Authorization: Bearer {{login.response.body.$.token}}
Accept: application/json

### Criar Quadras
POST {{base_url}}/api/quadras
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "Nome": "Quadra de Volei 4",
  "HorFuncionamentoInicio": 23,
  "HorFuncionamentoFim": 6,
  "VlrQuadra": 100.12
}

### Atualizar Quadras
PUT {{base_url}}/api/quadras/1
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "Nome": "Quadra de Volei 1",
  "HorFuncionamentoInicio": 23,
  "HorFuncionamentoFim": 6,
  "VlrQuadra": 100.12
}

### Excluir Quadras
DELETE {{base_url}}/api/quadras/2
Authorization: Bearer {{login.response.body.$.token}}
Accept: application/json